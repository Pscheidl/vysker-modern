# Copy to deploy/.env, keep it private and outside Git.
# Build this immutable image tag on the workstation and transfer it using
# docker save, SSH and docker load. Never compile on the 2 GB VPS.
WEB_IMAGE=obecni-web:REPLACE_WITH_SOURCE_REVISION
OBEC_MIN_PASSWORD_LENGTH=24

# Only used with compose.staging-https.yaml. For this deployment: vysker.info.
DOMAIN=staging.example.test
TLS_EMAIL=administrator@example.test
# The frontend is public, administration requires its own application login.
# X-Robots-Tag discourages indexing, it does not restrict access.

# Database passwords are fresh random secrets, never placed in this env file.
# deploy/secrets/postgres-password.txt: PostgreSQL administrator password
# deploy/secrets/database-password.txt: password for application role vysker
# deploy/secrets/database-url.txt: postgresql://vysker:PASSWORD@postgres:5432/vysker
# Use URL-safe generated passwords or percent-encode the database URL password.
# database-url.txt must be readable by container UID 10001 without making the
# parent deploy/secrets directory accessible to unprivileged host accounts.

# Default mail delivery is captured by isolated Mailpit. Backup services are
# not part of this setup. Do not copy real subscriber records into the test.
# Only add compose.staging-smtp.yaml after real outgoing email is authorized.
# The overlay needs deploy/secrets/smtp-password.txt, readable by UID 10001.
# On a fresh DB, these variables select the sender and encrypted SMTP service.
# Stored Google settings from administration can override the environment when
# capture mode is disabled. Verify the effective sender in administration.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_TLS=tls
# SMTP_USERNAME=sender@example.test
# EMAIL_FROM=sender@example.test
