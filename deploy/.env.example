# Copy to deploy/.env and fill municipality-approved production values.
DOMAIN=web.example.test
TLS_EMAIL=administrator@example.test
# Pool limits apply to each application process.
DB_POOL_MAX_CONNECTIONS=50
DB_POOL_MIN_CONNECTIONS=0
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=10
# Zero disables idle retirement or maximum lifetime respectively.
DB_POOL_IDLE_TIMEOUT_SECONDS=600
DB_POOL_MAX_LIFETIME_SECONDS=1800
# Server-wide limit, including all app instances, tools and reserved admin slots.
POSTGRES_MAX_CONNECTIONS=75
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USERNAME=municipality
EMAIL_FROM=Vyskeř <novinky@example.test>
# Office public address or VPN network, never 0.0.0.0/0.
ADMIN_NETWORKS=192.0.2.1/32
