# Assemble a runtime from locally compiled Rust/WASM artifacts.
# The build context must be a narrow release bundle, not the working checkout.
FROM postgres:18-bookworm@sha256:3725f4e2499eef5134592b3b4ab79a543ed7f8e533b05b5b637af926630f6650
ENTRYPOINT []
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-psycopg python3-bs4 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 obec && useradd --uid 10001 --gid obec --no-create-home obec \
    && mkdir -p /app/data /app/backups /app/monitor /app/migration \
    && chown obec:obec /app/data /app/backups /app/monitor /app/migration
WORKDIR /app
COPY obecni-web obec-admin ./
COPY site ./target/site
COPY Cargo.toml ./
COPY scripts ./scripts
COPY config ./config
USER 10001:10001
ENV OBEC_ADRESA=0.0.0.0:3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:3000/api/v1/ready || exit 1
CMD ["./obecni-web"]
