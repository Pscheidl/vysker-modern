OBEC_ADRESA=127.0.0.1:3000
OBEC_DATABAZE=postgresql://vysker:vysker@127.0.0.1:5432/vysker
# Pool defaults: development 10 connections, production 50 connections per process.
# This local example explicitly uses the development limit.
DB_POOL_MAX_CONNECTIONS=10
DB_POOL_MIN_CONNECTIONS=0
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=10
# Set either of these two values to 0 to disable its connection retirement rule.
DB_POOL_IDLE_TIMEOUT_SECONDS=600
DB_POOL_MAX_LIFETIME_SECONDS=1800
OBEC_VEREJNA_URL=http://localhost:3000
OBEC_UKAZKOVA_DATA=false
OBEC_SMTP_HOST=127.0.0.1
OBEC_SMTP_PORT=1025
# Unencrypted SMTP is for local Mailpit only.
OBEC_SMTP_TLS=none
OBEC_EMAIL_OD='Vyskeř <noreply@vysker.test>'
# For a real SMTP service, set TLS to starttls or tls and supply both credentials.
# OBEC_SMTP_UZIVATEL=
# OBEC_SMTP_HESLO=

# Google mail can be configured in administration with an email and app password.
# Encryption key is generated on first save. Persist and back up this file with the database.
OBEC_MAIL_SETTINGS_KEY_FILE=data/mail-settings.key

# Development example. Production requires a completed, municipality-approved JSON policy.
OBEC_PRIVACY_CONFIG=config/privacy.example.json
OBEC_PRODUCTION=false

# Accept X-Real-IP only from this exact proxy address.
# OBEC_TRUSTED_PROXY=172.30.64.2
# Read the password from a file instead of a direct environment value.
# OBEC_SMTP_HESLO_FILE=/run/secrets/smtp_password

# Minimum administrator password length in Unicode characters.
OBEC_MIN_PASSWORD_LENGTH=24
