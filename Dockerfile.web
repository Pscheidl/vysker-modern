# syntax=docker/dockerfile:1
FROM rust:1.98.1-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown \
    && cargo install cargo-leptos --locked --version 0.3.7
WORKDIR /app
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
COPY migrations ./migrations
COPY seed-demo.sql ./
COPY demo ./demo
COPY config ./config
COPY public ./public
COPY style ./style
RUN cargo leptos build --release --lib-cargo-args=--locked --bin-cargo-args=--locked \
    && cargo build --locked --release --bin obec-admin

FROM postgres:18-bookworm AS runtime
ENTRYPOINT []
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-psycopg python3-bs4 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 obec && useradd --uid 10001 --gid obec --no-create-home obec \
    && mkdir -p /app/data /app/backups /app/monitor /app/migration \
    && chown obec:obec /app/data /app/backups /app/monitor /app/migration
WORKDIR /app
COPY --from=build /app/target/release/obecni-web /app/target/release/obec-admin ./
COPY --from=build /app/target/site ./target/site
COPY Cargo.toml ./
COPY scripts/database.py scripts/monitor.py scripts/postgres.py ./scripts/
COPY scripts/legacy.py scripts/legacy_galleries.py scripts/legacy_import.py scripts/legacy_scope.py scripts/legacy_sync.py scripts/legacy_archive.py ./scripts/
COPY scripts/legacy_reimport.py scripts/legacy_replace.py ./scripts/
COPY config/legacy-vysker-pages.json config/legacy-vysker-notices.json ./config/
USER 10001:10001
ENV OBEC_ADRESA=0.0.0.0:3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:3000/api/v1/ready || exit 1
CMD ["./obecni-web"]
